{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix integrations/kool --ignore-scripts --no-audit --no-fund",
  "buildCommand": "node scripts/build-landing-kool.mjs",
  "outputDirectory": "landing",
  "cleanUrls": true,
  "trailingSlash": false,
  "github": { "silent": true },
  "functions": { "api/kool-download.js": { "maxDuration": 90 } },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
